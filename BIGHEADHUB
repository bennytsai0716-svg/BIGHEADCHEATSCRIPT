        btn.BackgroundColor3 = isSelected and theme.ItemBg or theme.MainBg
        btn.TextColor3 = isSelected and theme.Accent or theme.Text
    end

    for _, elem in ipairs(allElements) do
        if elem.ApplyTheme then
            elem.ApplyTheme(theme)
        elseif elem.Frame then
            if elem.Frame:IsA("TextBox") or elem.Frame:IsA("TextButton") then
                elem.Frame.BackgroundColor3 = theme.ItemBg
                elem.Frame.TextColor3 = theme.Text
            elseif elem.Frame:IsA("Frame") and not elem.CustomTheme then
                elem.Frame.BackgroundColor3 = theme.ItemBg
            end
        end
    end
end

