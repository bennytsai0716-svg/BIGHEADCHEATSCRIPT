local LowQualityEnabled = false
local originalSky = nil
local originalTransparency = {} -- 用來記錄每個物件原本的透明度
local originalMeshTextureIDs = {} -- 用來記錄 MeshPart 原本的 TextureID

createToggleButton(WorldPage, "LowQuality", function(s)
    LowQualityEnabled = s
    
    if LowQualityEnabled then
        -- 1. 刪除/隱藏天空 (Sky)
        local sky = Lighting:FindFirstChildOfClass("Sky")
        if sky then
            originalSky = sky:Clone() -- 備份原本的天空以便恢復
            sky:Destroy()
        end
        
        -- 2. 清除貼圖、Decal 並記錄原本透明度，同時處理 MeshPart 與 BasePart
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Texture") or obj:IsA("Decal") then
                -- 紀錄原本的透明度
                if originalTransparency[obj] == nil then
                    originalTransparency[obj] = obj.Transparency
                end
                -- 清空圖片 ID 並設為完全透明
                obj.Texture = ""
                obj.Transparency = 1
            elseif obj:IsA("MeshPart") then
                -- 紀錄 MeshPart 原本的 TextureID 並清空
                if originalMeshTextureIDs[obj] == nil then
                    originalMeshTextureIDs[obj] = obj.TextureID
                end
                obj.TextureID = ""
                obj.Material = Enum.Material.SmoothPlastic
            elseif obj:IsA("BasePart") then
                -- 強制關閉材質細節，轉為平滑塑膠
                obj.Material = Enum.Material.SmoothPlastic
            end
        end
    else
        -- 1. 恢復天空
        if originalSky and not Lighting:FindFirstChildOfClass("Sky") then
            originalSky.Parent = Lighting
        end
        
        -- 2. 恢復材質、透明度與 TextureID
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Texture") or obj:IsA("Decal") then
                -- 恢復原本紀錄的透明度
                if originalTransparency[obj] ~= nil then
                    obj.Transparency = originalTransparency[obj]
                else
                    obj.Transparency = 0
                end
            elseif obj:IsA("MeshPart") then
                -- 恢復 MeshPart 原本的 TextureID
                if originalMeshTextureIDs[obj] ~= nil then
                    obj.TextureID = originalMeshTextureIDs[obj]
                end
            end
        end
        
        -- 清空記錄表（釋放記憶體）
        originalTransparency = {}
        originalMeshTextureIDs = {}
    end
end)

