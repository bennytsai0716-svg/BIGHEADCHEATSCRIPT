local FovCircle = Drawing.new("Circle")
FovCircle.Color = Color3.fromRGB(0, 230, 255) 
FovCircle.Thickness = 1.5 
FovCircle.NumSides = 32 
FovCircle.Filled = false

local function isPartVisible(targetPart, model)
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character, model}
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    return workspace:Raycast(Camera.CFrame.Position, targetPart.Position - Camera.CFrame.Position, rayParams) == nil
end

local function getClosestTarget(checkWall)
    local mousePos = UserInputService:GetMouseLocation()
    local closest, shortestDist = nil, AimFovSize

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local part = player.Character:FindFirstChild(AimTargetPart) or player.Character:FindFirstChild("HumanoidRootPart")
            if part then
                local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if dist < shortestDist then
                        local visible = not checkWall or isPartVisible(part, player.Character)
                        if visible then
                            if not peekTimers[player.Character] then peekTimers[player.Character] = os.clock() end
                            if (os.clock() - peekTimers[player.Character]) * 1000 >= AimPeekDelay then
                                shortestDist = dist
                                closest = part
                            end
                        else
                            peekTimers[player.Character] = nil
                        end
                    end
                end
            end
        end
    end
    return closest
end

RunService.RenderStepped:Connect(function()
    if not IsScriptLoaded then return end

    if FovEnabled and not FreecamEnabled then
        if Camera.FieldOfView ~= TargetFov then
            Camera.FieldOfView = TargetFov
        end
    end
    
    FovCircle.Position = UserInputService:GetMouseLocation()
    FovCircle.Radius = AimFovSize
    FovCircle.Visible = AimbotEnabled and ShowFovCircle and not FreecamEnabled

    if FullbrightEnabled then
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
    end

    if AimbotEnabled and not FreecamEnabled and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local targetPart = getClosestTarget(AimWallCheck)
        if targetPart then
            local mousePos = UserInputService:GetMouseLocation()
            local targetPos = Camera:WorldToViewportPoint(targetPart.Position)
            local moveVector = (Vector2.new(targetPos.X, targetPos.Y) - mousePos) * AimSmoothness

            if mousemoverel then
                mousemoverel(moveVector.X, moveVector.Y)
            end
        end
    end

    if TriggerbotEnabled and not FreecamEnabled then
        local targetPart = getClosestTarget(true) 
        if targetPart then
            if (os.clock() - lastTriggerTime) * 1000 >= TriggerbotDelay then
                lastTriggerTime = os.clock()

                if mouse1click then
                    mouse1click()
                elseif mouse1press then
                    mouse1press()
                    task.spawn(function()
                        task.wait(0.01)
                        mouse1release()
                    end)
                end
            end
        end
    end
end)

local isTweening = false

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe or not IsScriptLoaded then return end
    if input.KeyCode == ToggleKey and not isTweening then
        UiVisible = not UiVisible
        isTweening = true
        
        if UiVisible then
            MainFrame.Visible = true
            fadeUI(MainFrame, true, 0.35)
            task.wait(0.35)
        else
            fadeUI(MainFrame, false, 0.35)
            task.wait(0.35)
            if not UiVisible then
                MainFrame.Visible = false
            end
        end
        
        isTweening = false
    end
end)

