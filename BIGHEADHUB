applyConfigTable = function(data)
    if type(data) ~= "table" then return end

    if data.CurrentLanguage then 
        CurrentLanguage = data.CurrentLanguage 
        for _, elem in ipairs(allElements) do
            if elem.Key == "LangSelect" and elem.SetSelected then elem.SetSelected(CurrentLanguage) end
        end
        refreshUiLanguage() 
    end
    if data.CurrentThemeKey then 
        applyTheme(data.CurrentThemeKey) 
        for _, elem in ipairs(allElements) do
            if elem.Key == "ThemeSelect" and elem.SetSelected then elem.SetSelected(data.CurrentThemeKey) end
        end
    end

    local function applyElemValue(key, val, isSlider, isTextBox)
        if val == nil then return end
        for _, elem in ipairs(allElements) do
            if elem.Key == key then
                if isSlider and elem.SetValue then elem.SetValue(val)
                elseif isTextBox and elem.SetText then elem.SetText(val)
                elseif elem.Update then elem.Update(val) end
            end
        end
    end

    -- Combat
    applyElemValue("Aimbot", data.AimbotEnabled)
    if data.AimSmoothness then applyElemValue("Smoothness", math.floor(data.AimSmoothness * 10), true) end
    applyElemValue("Wallcheck", data.AimWallCheck)
    applyElemValue("PeekDelay", data.AimPeekDelay, true)
    applyElemValue("FovSize", data.AimFovSize, true)
    applyElemValue("ShowFov", data.ShowFovCircle)
    applyElemValue("Triggerbot", data.TriggerbotEnabled)
    applyElemValue("TriggerDelay", data.TriggerbotDelay, true)
    applyElemValue("Fling", data.FlingEnabled)
    applyElemValue("FlingInput", data.FlingTargetName, false, true)
    applyElemValue("AntiFling", data.AntiFlingEnabled)

    -- Movement
    applyElemValue("Fly", data.FlyEnabled)
    applyElemValue("FlySpeed", data.FlySpeed, true)
    applyElemValue("Speed", data.SpeedEnabled)
    applyElemValue("WalkSpeed", data.TargetSpeed, true)
    applyElemValue("InfJump", data.InfiniteJumpEnabled)
    applyElemValue("Noclip", data.NoclipEnabled)
    applyElemValue("Invisible", data.InvisibleEnabled)

    -- Teleport
    if data.TeleportMethod then
        TeleportMethod = data.TeleportMethod
        for _, elem in ipairs(allElements) do
            if elem.Key == "TpMethod" and elem.SetSelected then elem.SetSelected(TeleportMethod) end
        end
    end
    applyElemValue("TpSpeed", data.TeleportFlySpeed, true)

    -- ESP
    applyElemValue("PlayerEsp", data.EspEnabled)
    applyElemValue("HumanoidEsp", data.AllHumanoidEspEnabled)
    applyElemValue("VisibleCheck", data.EspVisibleCheckEnabled)

    -- Camera
