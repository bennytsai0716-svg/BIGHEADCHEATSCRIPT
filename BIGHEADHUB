RunService.RenderStepped:Connect(function()
    if IsScriptLoaded and FreecamEnabled and _G.FreecamCam then
        local rotCFrame = CFrame.Angles(0, freecamRotation.Y, 0) * CFrame.Angles(freecamRotation.X, 0, 0)
        local moveVec = Vector3.new(0, 0, 0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveVec = moveVec + rotCFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveVec = moveVec - rotCFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveVec = moveVec - rotCFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveVec = moveVec + rotCFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.E) then moveVec = moveVec + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.Q) then moveVec = moveVec - Vector3.new(0, 1, 0) end
        
        _G.FreecamCam.CFrame = CFrame.new(_G.FreecamCam.CFrame.Position + (moveVec * FreecamSpeed)) * rotCFrame
        Camera.CFrame = _G.FreecamCam.CFrame
    end
end)

