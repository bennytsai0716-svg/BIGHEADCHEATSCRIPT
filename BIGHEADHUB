-- [[ 動態推擠式下拉表單 ]]
local function createInlineDropdown(parent, labelKey, options, defaultCode, onSelect, dynamicGetOptions)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 36)
    container.BackgroundColor3 = Themes[CurrentThemeKey].ItemBg
    container.BorderSizePixel = 0
    container.ClipsDescendants = true
    container.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = container

    local mainBtn = Instance.new("TextButton")
    mainBtn.Size = UDim2.new(1, 0, 0, 36)
    mainBtn.BackgroundTransparency = 1
    mainBtn.TextSize = 14
    mainBtn.Font = Enum.Font.SourceSansBold
    mainBtn.TextColor3 = Themes[CurrentThemeKey].Accent
    mainBtn.Parent = container

    local scrollList = Instance.new("ScrollingFrame")
    scrollList.Size = UDim2.new(1, -10, 0, 200)
    scrollList.Position = UDim2.new(0, 5, 0, 40)
    scrollList.BackgroundTransparency = 1
    scrollList.BorderSizePixel = 0
    scrollList.ScrollBarThickness = 3
    scrollList.ScrollBarImageColor3 = Themes[CurrentThemeKey].Accent
    scrollList.Parent = container

    local listLayout = Instance.new("UIListLayout")
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Padding = UDim.new(0, 4)
    listLayout.Parent = scrollList

    listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        scrollList.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 5)
    end)

    local isOpen = false
    local selectedCode = defaultCode

    local function updateTitle()
        local nameStr = ""
        local currentOpts = dynamicGetOptions and dynamicGetOptions() or options
        for _, opt in ipairs(currentOpts) do
            if opt.code == selectedCode then nameStr = opt.name break end
        end
        if nameStr == "" and #currentOpts > 0 then nameStr = currentOpts[1].name end
        mainBtn.Text = getTxt(labelKey) .. ": " .. nameStr .. (isOpen and " ▲" or " ▼")
    end

    local function buildOptionsList()
        for _, child in ipairs(scrollList:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        local currentOpts = dynamicGetOptions and dynamicGetOptions() or options
        for _, opt in ipairs(currentOpts) do
            local itemBtn = Instance.new("TextButton")
            itemBtn.Size = UDim2.new(1, 0, 0, 28)
            itemBtn.BackgroundColor3 = Themes[CurrentThemeKey].MainBg
            itemBtn.Text = opt.name
            itemBtn.TextColor3 = Themes[CurrentThemeKey].Text
            itemBtn.TextSize = 13
            itemBtn.Font = Enum.Font.SourceSans
            itemBtn.BorderSizePixel = 0
            itemBtn.Parent = scrollList

            local itemCorner = Instance.new("UICorner")
            itemCorner.CornerRadius = UDim.new(0, 4)
            itemCorner.Parent = itemBtn

            itemBtn.MouseButton1Click:Connect(function()
                selectedCode = opt.code
                isOpen = false
                updateTitle()
                TweenService:Create(container, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, 36)}):Play()
                onSelect(opt.code)
            end)
        end
    end

    local function toggleDropdown()
        isOpen = not isOpen
        if isOpen then buildOptionsList() end
        updateTitle()
        local targetHeight = isOpen and (45 + math.min(scrollList.CanvasSize.Y.Offset, 200)) or 36
        local tweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        TweenService:Create(container, tweenInfo, {Size = UDim2.new(1, 0, 0, targetHeight)}):Play()
    end

    mainBtn.MouseButton1Click:Connect(toggleDropdown)

    local function applyTheme(theme)
        container.BackgroundColor3 = theme.ItemBg
        mainBtn.TextColor3 = theme.Accent
        scrollList.ScrollBarImageColor3 = theme.Accent
        for _, child in ipairs(scrollList:GetChildren()) do
            if child:IsA("TextButton") then
                child.BackgroundColor3 = theme.MainBg
                child.TextColor3 = theme.Text
            end
        end
    end

    updateTitle()
    table.insert(allElements, {
        Frame = container, 
        Key = labelKey, 
        Refresh = updateTitle, 
        ApplyTheme = applyTheme, 
        CustomTheme = true,
        SetSelected = function(code)
            selectedCode = code
            updateTitle()
            onSelect(code)
        end,
        GetSelected = function() return selectedCode end
    })
    return container
end

