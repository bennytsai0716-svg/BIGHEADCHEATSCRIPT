-- [[ 漸顯ui函式 ]]
local originalTransparencies = {}

local function saveOriginalTransparencies(parent)
    for _, obj in ipairs(parent:GetDescendants()) do
        if not originalTransparencies[obj] then
            originalTransparencies[obj] = {
                BackgroundTransparency = obj:IsA("GuiObject") and obj.BackgroundTransparency or nil,
                TextTransparency = (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) and obj.TextTransparency or nil,
                ImageTransparency = (obj:IsA("ImageLabel") or obj:IsA("ImageButton")) and obj.ImageTransparency or nil,
                UIStrokeTransparency = obj:IsA("UIStroke") and obj.Transparency or nil,
            }
        end
    end
    -- 記錄 MainFrame 本身
    if not originalTransparencies[parent] then
        originalTransparencies[parent] = {
            BackgroundTransparency = parent.BackgroundTransparency
        }
    end
end

-- 執行整體 Fade 動畫
local function fadeUI(targetFrame, visible, duration)
    saveOriginalTransparencies(targetFrame)
    local tweenInfo = TweenInfo.new(duration or 0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    
    local allObjects = targetFrame:GetDescendants()
    table.insert(allObjects, targetFrame)

    for _, obj in ipairs(allObjects) do
        local orig = originalTransparencies[obj]
        if orig then
            local goal = {}
            
            if visible then
                -- 淡入：恢復原始設定的透明度
                if orig.BackgroundTransparency then goal.BackgroundTransparency = orig.BackgroundTransparency end
                if orig.TextTransparency then goal.TextTransparency = orig.TextTransparency end
                if orig.ImageTransparency then goal.ImageTransparency = orig.ImageTransparency end
                if orig.UIStrokeTransparency then goal.Transparency = orig.UIStrokeTransparency end
            else
                -- 淡出：全部轉為完全透明 (1)
                if orig.BackgroundTransparency then goal.BackgroundTransparency = 1 end
                if orig.TextTransparency then goal.TextTransparency = 1 end
                if orig.ImageTransparency then goal.ImageTransparency = 1 end
                if orig.UIStrokeTransparency then goal.Transparency = 1 end
            end
            
            TweenService:Create(obj, tweenInfo, goal):Play()
        end
    end
end


