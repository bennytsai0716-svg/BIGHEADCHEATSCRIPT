    -- World
    applyElemValue("Fullbright", data.FullbrightEnabled)
    applyElemValue("Xray", data.MapXrayEnabled)
    applyElemValue("SkyBk", data.SkyBk, false, true)
    applyElemValue("SkyDn", data.SkyDn, false, true)
