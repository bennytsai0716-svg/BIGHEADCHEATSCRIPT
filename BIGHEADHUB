local function createToggleButton(parent, textKey, callback, default)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 36)
    frame.BackgroundColor3 = Themes[CurrentThemeKey].ItemBg
    frame.BorderSizePixel = 0
    frame.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = frame

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.TextSize = 14
    btn.Font = Enum.Font.SourceSans
    btn.Parent = frame

    local state = false
    local function update(s, skipCallback)
        state = s
        btn.Text = getTxt(textKey) .. (state and getTxt("StateOn") or getTxt("StateOff"))
        btn.TextColor3 = state and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100)
        if not skipCallback then callback(state) end
    end

    local function refreshText()
        btn.Text = getTxt(textKey) .. (state and getTxt("StateOn") or getTxt("StateOff"))
    end

    btn.MouseButton1Click:Connect(function()
        update(not state)
    end)

    if default then update(true) else update(false) end
    table.insert(allElements, {Frame = frame, Key = textKey, Refresh = refreshText, Update = update, GetState = function() return state end})
    return {Update = update}
end

