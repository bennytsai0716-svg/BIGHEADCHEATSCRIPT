local function setupModelEsp(model)
    if espObjects[model] then
        return
    end

    local hum = model:FindFirstChildOfClass("Humanoid")
    local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso")

    if not hum or not hrp or model == LocalPlayer.Character then
        return
    end

    local tracer = Drawing.new("Line")
    tracer.Visible = false
    tracer.Color = Color3.fromRGB(0, 230, 255)
    tracer.Thickness = 1.5

    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = Color3.fromRGB(0, 230, 255)
    box.Thickness = 1.5
    box.Filled = false

    local nameTag = Drawing.new("Text")
    nameTag.Visible = false
    nameTag.Color = Color3.fromRGB(255, 255, 255)
    nameTag.Size = 14
    nameTag.Center = true
    nameTag.Outline = true

    espObjects[model] = {
        tracer = tracer,
        box = box,
        nameTag = nameTag
    }

    local connection

    connection = RunService.RenderStepped:Connect(function()
        if not IsScriptLoaded or not model.Parent or not hrp.Parent or not hum.Parent or hum.Health <= 0 then
            tracer.Visible = false
            box.Visible = false
            nameTag.Visible = false

            if not model.Parent or hum.Health <= 0 then
                pcall(function()
                    tracer:Remove()
                    box:Remove()
                    nameTag:Remove()
                end)

                if connection then
                    connection:Disconnect()
                end

                espObjects[model] = nil
            end

            return
        end

        local isPlayer = Players:GetPlayerFromCharacter(model) ~= nil
        local shouldShow = (isPlayer and EspEnabled) or (not isPlayer and AllHumanoidEspEnabled)

        if not shouldShow then
            tracer.Visible = false
            box.Visible = false
            nameTag.Visible = false
            return
        end

        local boundingCFrame, boundingSize = model:GetBoundingBox()
        local half = boundingSize / 2

        local corners = {
            Vector3.new(-half.X, -half.Y, -half.Z),
            Vector3.new(-half.X, -half.Y,  half.Z),
            Vector3.new(-half.X,  half.Y, -half.Z),
            Vector3.new(-half.X,  half.Y,  half.Z),
            Vector3.new( half.X, -half.Y, -half.Z),
            Vector3.new( half.X, -half.Y,  half.Z),
            Vector3.new( half.X,  half.Y, -half.Z),
            Vector3.new( half.X,  half.Y,  half.Z)
        }

        local minX, minY = math.huge, math.huge
        local maxX, maxY = -math.huge, -math.huge
        local anyOnScreen = false

        for _, corner in ipairs(corners) do
            local worldPoint = boundingCFrame:PointToWorldSpace(corner)
            local screenPoint, onScreen = Camera:WorldToViewportPoint(worldPoint)

            if screenPoint.Z > 0 then
                minX = math.min(minX, screenPoint.X)
                minY = math.min(minY, screenPoint.Y)
                maxX = math.max(maxX, screenPoint.X)
                maxY = math.max(maxY, screenPoint.Y)

                if onScreen then
                    anyOnScreen = true
                end
            end
        end

        if not anyOnScreen or minX == math.huge then
            tracer.Visible = false
            box.Visible = false
            nameTag.Visible = false
            return
        end

        local boxWidth = maxX - minX
        local boxHeight = maxY - minY

        if boxWidth < 2 or boxHeight < 2 then
            tracer.Visible = false
            box.Visible = false
            nameTag.Visible = false
            return
        end

        box.Position = Vector2.new(minX, minY)
        box.Size = Vector2.new(boxWidth, boxHeight)
        box.Visible = true

        tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
        tracer.To = Vector2.new((minX + maxX) / 2, maxY)
        tracer.Visible = true

        nameTag.Text = model.Name
        nameTag.Position = Vector2.new((minX + maxX) / 2, minY - 18)
        nameTag.Visible = true
    end)
end

